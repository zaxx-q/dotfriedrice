#!/usr/bin/env bash
# Open a Ghostty window to run resolve-convert in-place.

set -Eeuo pipefail

profile="${1:-lb}"
shift || true
[[ $# -gt 0 ]] || exit 0

bin_dir="$(dirname "$(readlink -f "$0")")"
# shellcheck disable=SC2016
exec ghostty --gtk-single-instance=false --title="Convert for DaVinci Resolve ($profile)" \
  -e bash -c '
    "$1/resolve-convert" "$2" "${@:3}"
    status=$?
    printf "\nFinished. Press Enter to close this window..."
    read -r
    exit "$status"
  ' resolve-convert-thunar "$bin_dir" "$profile" "$@"
