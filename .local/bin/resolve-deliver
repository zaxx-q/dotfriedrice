#!/usr/bin/env bash
# Produce web-ready H.264/AAC MP4 files from Resolve masters or other video.

set -Eeuo pipefail

MODE="quality"
CRF=18
QP=20
FORCE=false
OUTPUT=""

usage() {
  cat <<'EOF'
Usage: resolve-deliver [options] <master-video> [...]

Create a broadly compatible H.264/AAC MP4 beside each selected input.

Options:
      --quality          Software x264: best quality per file size (default)
      --fast             AMD VA-API H.264: faster, less compression-efficient
      --crf N            x264 quality value for --quality (default: 18)
      --qp N             VA-API constant-quality value for --fast (default: 20)
  -o, --output FILE      Output path; valid with exactly one input
  -f, --force            Replace an existing output
  -h, --help             Show this help

Examples:
  resolve-deliver --quality ~/Videos/Resolve/Projects/demo/03-exports/master.mov
  resolve-deliver --fast -o final.mp4 master.mov
EOF
}

info() { printf '[resolve-deliver] %s\n' "$*"; }
warn() { printf '[resolve-deliver] WARNING: %s\n' "$*" >&2; }
die() { printf '[resolve-deliver] ERROR: %s\n' "$*" >&2; exit 1; }

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a 'DaVinci Resolve' "$1" "$2" >/dev/null 2>&1 || true
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quality)
      MODE="quality"
      shift
      ;;
    --fast)
      MODE="fast"
      shift
      ;;
    --crf)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--crf requires an integer"
      CRF="$2"
      shift 2
      ;;
    --qp)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--qp requires an integer"
      QP="$2"
      shift 2
      ;;
    -o|--output)
      [[ $# -ge 2 ]] || die "$1 requires an output path"
      OUTPUT="$2"
      shift 2
      ;;
    -f|--force)
      FORCE=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -gt 0 ]] || {
  usage >&2
  exit 2
}
[[ -z "$OUTPUT" || $# -eq 1 ]] || die "--output can only be used with one input"
command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg is required"

if [[ "$MODE" == fast ]]; then
  [[ -r /dev/dri/renderD128 ]] || die 'AMD VA-API device /dev/dri/renderD128 is unavailable'
fi

converted=0
failed=0

for input in "$@"; do
  [[ -f "$input" ]] || {
    warn "Skipping unavailable input: $input"
    ((++failed))
    continue
  }

  input=$(realpath "$input")
  if [[ -n "$OUTPUT" ]]; then
    output=$(realpath -m "$OUTPUT")
  else
    stem="${input%.*}"
    output="${stem}-web-${MODE}.mp4"
  fi

  [[ "$input" != "$output" ]] || die "refusing to overwrite input: $input"
  if [[ -e "$output" && $FORCE == false ]]; then
    info "Skip existing output: $output"
    continue
  fi

  mkdir -p "$(dirname "$output")"
  temporary="$(dirname "$output")/.${output##*/}.partial.mp4"
  rm -f -- "$temporary"
  info "${MODE}: $input -> $output"

  if [[ "$MODE" == quality ]]; then
    if ffmpeg -nostdin -hide_banner -loglevel error -stats \
        -i "$input" -map 0:v:0 -map 0:a? -map_metadata 0 \
        -c:v libx264 -preset medium -crf "$CRF" -pix_fmt yuv420p \
        -c:a aac -b:a 192k -movflags +faststart -y "$temporary"; then
      mv -f -- "$temporary" "$output"
      ((++converted))
    else
      rm -f -- "$temporary"
      ((++failed))
      warn "Delivery failed: $input"
    fi
  else
    if ffmpeg -nostdin -hide_banner -loglevel error -stats \
        -vaapi_device /dev/dri/renderD128 -i "$input" \
        -map 0:v:0 -map 0:a? -map_metadata 0 \
        -vf 'format=nv12,hwupload' \
        -c:v h264_vaapi -rc_mode CQP -qp "$QP" -profile:v high -g 60 \
        -c:a aac -b:a 192k -movflags +faststart -y "$temporary"; then
      mv -f -- "$temporary" "$output"
      ((++converted))
    else
      rm -f -- "$temporary"
      ((++failed))
      warn "Delivery failed: $input"
    fi
  fi
done

info "Summary: delivered=$converted failed=$failed"
if (( failed > 0 )); then
  notify 'Resolve delivery failed' "$failed file(s) failed."
  exit 1
fi
notify 'Resolve delivery complete' "$converted MP4 file(s) created."
