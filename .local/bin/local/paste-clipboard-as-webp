#!/usr/bin/env bash
# paste-clipboard-as-webp.sh
# Saves an image currently on the clipboard as a .webp file in a target directory.
# Intended to be wired up as a Thunar custom action (command: paste-clipboard-as-webp %f)

set -euo pipefail

TARGET_DIR="${1:-$PWD}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
TMP_PNG="$(mktemp --suffix=.png)"
OUTPUT="$TARGET_DIR/pasted-image-$TIMESTAMP.webp"

# WebP quality (0-100). 80-85 is plenty for photos; screenshots/UI/text hold up
# better a bit higher since flat colors and sharp edges show artifacts sooner.
# Override per-run with: WEBP_QUALITY=80 paste-clipboard-as-webp.sh <dir>
QUALITY="${WEBP_QUALITY:-82}"

cleanup() { rm -f "$TMP_PNG"; }
trap cleanup EXIT

notify() {
    notify-send "Paste as WebP" "$1" 2>/dev/null || \
    zenity --info --text="$1" 2>/dev/null || \
    echo "$1"
}

notify_error() {
    notify-send -u critical "Paste as WebP" "$1" 2>/dev/null || \
    zenity --error --text="$1" 2>/dev/null || \
    echo "$1" >&2
}

grab_clipboard_image() {
    # Wayland
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
        wl-paste --type image/png  > "$TMP_PNG" 2>/dev/null && [ -s "$TMP_PNG" ] && return 0
        wl-paste --type image/jpeg > "$TMP_PNG" 2>/dev/null && [ -s "$TMP_PNG" ] && return 0
    fi
    # X11
    if command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -t image/png  -o > "$TMP_PNG" 2>/dev/null && [ -s "$TMP_PNG" ] && return 0
        xclip -selection clipboard -t image/jpeg -o > "$TMP_PNG" 2>/dev/null && [ -s "$TMP_PNG" ] && return 0
    fi
    return 1
}

if ! grab_clipboard_image; then
    notify_error "No image found on the clipboard."
    exit 1
fi

if command -v cwebp >/dev/null 2>&1; then
    cwebp -quiet -q "$QUALITY" "$TMP_PNG" -o "$OUTPUT"
elif command -v magick >/dev/null 2>&1; then
    magick "$TMP_PNG" -quality "$QUALITY" "$OUTPUT"
elif command -v convert >/dev/null 2>&1; then
    convert "$TMP_PNG" -quality "$QUALITY" "$OUTPUT"
else
    notify_error "Need cwebp (webp package) or ImageMagick installed."
    exit 1
fi

notify "Saved: $(basename "$OUTPUT")"
