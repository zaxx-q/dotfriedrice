#!/usr/bin/env bash
# Toggle between standard gaps/struts/borders and zero-gap/flush layout in Niri.

set -o errexit
set -o nounset
set -o pipefail

config="${XDG_CONFIG_HOME:-${HOME}/.config}/niri/config.kdl"

if [[ ! -e "${config}" ]]; then
    printf 'Niri config not found: %s\n' "${config}" >&2
    exit 1
fi

config="$(readlink -f "${config}")"

status="$(python3 - "${config}" <<'EOF'
import sys, re

config_path = sys.argv[1]

with open(config_path, "r", encoding="utf-8") as f:
    content = f.read()

m = re.search(r'// Toggleable gaps\s*\n\s*(gaps\s+\d+)', content)
if not m:
    print("Error: Could not find '// Toggleable gaps' marker in config", file=sys.stderr)
    sys.exit(1)

is_normal = "gaps 0" not in m.group(1)

if is_normal:
    content = re.sub(r'(// Toggleable gaps\s*\n\s*)gaps\s+\d+', r'\1gaps 0', content)
    content = re.sub(r'(// Toggleable focus-ring\s*\n\s*)focus-ring\s*\{', r'\1/-focus-ring {', content)
    content = re.sub(r'(// Toggleable struts\s*\n\s*)struts\s*\{', r'\1/-struts {', content)
    content = re.sub(r'(// Toggleable corner-radius\s*\n\s*)geometry-corner-radius\s+\d+', r'\1geometry-corner-radius 0', content)
    status = "Zero gaps (flush mode)"
else:
    content = re.sub(r'(// Toggleable gaps\s*\n\s*)gaps\s+\d+', r'\1gaps 2', content)
    content = re.sub(r'(// Toggleable focus-ring\s*\n\s*)/-focus-ring\s*\{', r'\1focus-ring {', content)
    content = re.sub(r'(// Toggleable struts\s*\n\s*)/-struts\s*\{', r'\1struts {', content)
    content = re.sub(r'(// Toggleable corner-radius\s*\n\s*)geometry-corner-radius\s+\d+', r'\1geometry-corner-radius 20', content)
    status = "Normal gaps"

with open(config_path, "w", encoding="utf-8") as f:
    f.write(content)

print(status)
EOF
)"

if ! niri msg action load-config-file; then
    printf 'Niri rejected updated config.\n' >&2
    exit 1
fi

notify-send "Niri layout: ${status}" 2>/dev/null || true
printf 'Niri layout: %s\n' "${status}"
