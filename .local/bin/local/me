#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: magic-exec <prompt>" >&2
  exit 1
fi

PROMPT="$*"

SYSTEM_PROMPT="You are a shell command generator. Output ONLY a raw Bash command or Bash script that fulfills the user's request. Do not include explanations, markdown, code fences, or commentary."

# Run a single isolated turn: use no discovered instructions, skills, or
# extensions. Load only the environment-details extension explicitly.
RAW="$(pi -p \
  --no-tools \
  --no-session \
  --no-context-files \
  --no-skills \
  --no-extensions \
  --no-prompt-templates \
  --no-themes \
  --extension "$HOME/.pi/agent/extensions/environment-details.ts" \
  --model gemini-3.5-flash-low \
  --system-prompt "$SYSTEM_PROMPT" \
  -- \
  "$PROMPT" 2>&1)"

# Strip ANSI escape sequences and trim whitespace
CMD="$(printf '%s' "$RAW" | sed 's/\x1b\[[0-9;?]*[a-zA-Z<>]//g; s/\x1b[()][AB012]//g; s/\r//g' | tr -d '\000-\010\013-\037\177' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"

if [[ -z "$CMD" ]]; then
  echo "Error: pi returned an empty command." >&2
  exit 1
fi

echo ""
echo "Generated command/script:"
printf '%s\n' "$CMD"
echo ""

while true; do
  read -r -p "Run it? [y]es, [i]nline edit, [e]dit, or [N]o: " CONFIRM
  case "$CONFIRM" in
    [yY]|[yY][eE][sS])
      echo ""
      bash -c "$CMD"
      break
      ;;
    [iI]|[iI][nN][lL][iI][nN][eE])
      if [[ "$CMD" == *$'\n'* ]]; then
        echo "Inline editing supports one-line commands only; use [e]dit for scripts."
        continue
      fi

      if read -r -e -i "$CMD" -p "Edit command: " EDITED_CMD; then
        if [[ -n "$EDITED_CMD" ]]; then
          CMD="$EDITED_CMD"
          echo ""
          echo "Edited command:"
          printf '%s\n' "$CMD"
          echo ""
        else
          echo "Error: edited command is empty." >&2
        fi
      else
        echo ""
      fi
      ;;
    [eE]|[eE][dD][iI][tT])
      TMPFILE="$(mktemp "${TMPDIR:-/tmp}/me.XXXXXX")"
      trap 'rm -f "$TMPFILE"' EXIT
      printf '%s\n' "$CMD" > "$TMPFILE"
      # $VISUAL and $EDITOR may include arguments (for example, "zed --wait").
      # Split the configured command so its executable and arguments are separate.
      read -r -a EDITOR_CMD <<< "${VISUAL:-${EDITOR:-nano}}"
      "${EDITOR_CMD[@]}" "$TMPFILE"
      CMD="$(<"$TMPFILE")"
      rm -f "$TMPFILE"
      trap - EXIT

      if [[ -z "$CMD" ]]; then
        echo "Error: edited command/script is empty." >&2
        exit 1
      fi

      echo ""
      echo "Edited command/script:"
      printf '%s\n' "$CMD"
      echo ""
      ;;
    *)
      echo "Aborted."
      exit 1
      ;;
  esac
done
