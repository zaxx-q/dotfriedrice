#!/usr/bin/env bash
# wallchemy-rotate — fetch a wallpaper from Wallhaven via wallchemy,
# with instant notification feedback, mode rotation, and subcommands.
#
# Usage:
#   wallchemy-rotate [next|rotate]   # Rotate through modes (default)
#   wallchemy-rotate random [term]   # Random search (term optional)
#   wallchemy-rotate top [range]       # Top wallpapers (default range: 1M)
#   wallchemy-rotate hot               # Hot / trending wallpapers
#   wallchemy-rotate collection [name] # Random wallpaper from collection
#   wallchemy-rotate favorite          # Save the current wallpaper locally
#   wallchemy-rotate favorites         # Browse, apply, open, or remove favorites
#   wallchemy-rotate favorites gallery # Open the favorites directory in Thunar
#   wallchemy-rotate prune-cache       # Keep only the newest cached wallpapers
#   wallchemy-rotate previous          # Restore the previous wallpaper
#   wallchemy-rotate open              # Open the current wallpaper's Wallhaven page
#   wallchemy-rotate blacklist         # Blacklist current wallpaper and fetch next
#   wallchemy-rotate --silent ...      # Suppress desktop notifications (for timer)

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallchemy-rotate"
STATE_FILE="$STATE_DIR/mode-index"
LOG_FILE="$STATE_DIR/last-run.log"
HISTORY_FILE="$STATE_DIR/history.json"
FAVORITES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/wallchemy-rotate/favorites"
FAVORITES_METADATA_DIR="$FAVORITES_DIR/.metadata"
WALLCHEMY_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallchemy/wallpapers"
CACHE_KEEP=150
HISTORY_KEEP=100

mkdir -p "$STATE_DIR" "$FAVORITES_DIR" "$FAVORITES_METADATA_DIR"
[[ -f "$HISTORY_FILE" ]] || printf '%s\n' '{"current": -1, "entries": []}' > "$HISTORY_FILE"

# -----------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------

SEARCH_TERMS=(
    "landscape"
    "nature mountains"
    "cyberpunk city"
    "anime scenery"
    "dark abstract"
    "space nebula"
    "forest"
    "ocean sunset"
    "minimalist"
    "architecture"
    "anime"
    "video game"
    "videogame"
)

COLLECTIONS=(
    # "my favourites"
    # "backgrounds"
)

TOP_RANGE="1M"

# -----------------------------------------------------------------
# Parse options & arguments
# -----------------------------------------------------------------

SILENT=false
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --silent|-s)
            SILENT=true
            ;;
        *)
            ARGS+=("$arg")
            ;;
    esac
done

ACTION="${ARGS[0]:-next}"
SUB_ARG="${ARGS[1]:-}"

# -----------------------------------------------------------------
# Logging & Notifications
# -----------------------------------------------------------------

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"; }

NOTIFY_ID=""

notify_start() {
    local title="$1"
    local msg="$2"
    log "Starting: $title — $msg"
    if [[ "$SILENT" == false ]] && command -v notify-send >/dev/null 2>&1; then
        NOTIFY_ID=$(notify-send -p \
            -a "Wallchemy" \
            -i "preferences-desktop-wallpaper" \
            -h string:x-canonical-private-synchronous:wallchemy \
            "$title" "$msg" 2>/dev/null || true)
    fi
}

notify_success() {
    local title="$1"
    local msg="$2"
    local icon="${3:-preferences-desktop-wallpaper}"
    log "Success: $title — $msg"
    if [[ "$SILENT" == false ]] && command -v notify-send >/dev/null 2>&1; then
        if [[ -n "$NOTIFY_ID" ]]; then
            notify-send -r "$NOTIFY_ID" \
                -a "Wallchemy" \
                -i "$icon" \
                -h string:x-canonical-private-synchronous:wallchemy \
                "$title" "$msg" 2>/dev/null || true
        else
            notify-send \
                -a "Wallchemy" \
                -i "$icon" \
                -h string:x-canonical-private-synchronous:wallchemy \
                "$title" "$msg" 2>/dev/null || true
        fi
    fi
}

notify_error() {
    local title="$1"
    local msg="$2"
    log "ERROR: $title — $msg"
    if [[ "$SILENT" == false ]] && command -v notify-send >/dev/null 2>&1; then
        if [[ -n "$NOTIFY_ID" ]]; then
            notify-send -r "$NOTIFY_ID" \
                -u critical \
                -a "Wallchemy" \
                -i "dialog-error" \
                -h string:x-canonical-private-synchronous:wallchemy \
                "$title" "$msg" 2>/dev/null || true
        else
            notify-send \
                -u critical \
                -a "Wallchemy" \
                -i "dialog-error" \
                -h string:x-canonical-private-synchronous:wallchemy \
                "$title" "$msg" 2>/dev/null || true
        fi
    fi
}

# Wallchemy retains every downloaded image. Limit its cache by image mtime;
# favorites are stored separately and are never included in this cleanup.
prune_wallchemy_cache() {
    local -a cached_files
    local cached_file
    local removed=0

    [[ -d "$WALLCHEMY_CACHE_DIR" ]] || return 0

    mapfile -d '' -t cached_files < <(
        find "$WALLCHEMY_CACHE_DIR" -maxdepth 1 -type f -printf '%T@ %p\0' \
            | sort -zrn
    )

    if (( ${#cached_files[@]} <= CACHE_KEEP )); then
        return 0
    fi

    for cached_file in "${cached_files[@]:CACHE_KEEP}"; do
        rm -f -- "${cached_file#* }"
        ((removed += 1))
    done

    log "Pruned $removed cached wallpaper(s); keeping $CACHE_KEEP newest"
}

record_current_wallpaper() {
    local label="$1"
    local info
    local id
    local image_url
    local page_url
    local image_path
    local temporary

    info=$(wallchemy --info 2>&1) || {
        log "Could not add current wallpaper to history: $info"
        return 0
    }

    id=$(printf '%s\n' "$info" | sed -n '1p')
    image_url=$(printf '%s\n' "$info" | sed -n '2p')
    page_url=$(printf '%s\n' "$info" | sed -n '3p')
    image_path=$(printf '%s\n' "$info" | sed -n '4p')

    if [[ ! "$id" =~ ^[[:alnum:]]+$ ]] \
        || [[ ! "$page_url" =~ ^https://wallhaven\.cc/w/[[:alnum:]]+$ ]]; then
        log "Could not add invalid wallpaper information to history"
        return 0
    fi

    temporary=$(mktemp "$STATE_DIR/.history.XXXXXX")
    if ! jq \
        --arg id "$id" \
        --arg image_url "$image_url" \
        --arg page_url "$page_url" \
        --arg image_path "$image_path" \
        --arg label "$label" \
        --arg saved_at "$(date --iso-8601=seconds)" \
        --argjson history_keep "$HISTORY_KEEP" '
            .entries = (.entries // [])
            | .current = (.current // ((.entries | length) - 1))
            | .entries = .entries[0:(.current + 1)]
            | if (.entries | length) > 0 and .entries[-1].id == $id then
                .entries[-1] = {
                    id: $id,
                    image_url: $image_url,
                    page_url: $page_url,
                    image_path: $image_path,
                    label: $label,
                    saved_at: $saved_at
                }
              else
                .entries += [{
                    id: $id,
                    image_url: $image_url,
                    page_url: $page_url,
                    image_path: $image_path,
                    label: $label,
                    saved_at: $saved_at
                }]
              end
            | .entries = (
                if (.entries | length) > $history_keep then .entries[-$history_keep:]
                else .entries
                end
              )
            | .current = ((.entries | length) - 1)
        ' "$HISTORY_FILE" > "$temporary"; then
        rm -f "$temporary"
        log "Could not write wallpaper history"
        return 0
    fi

    mv -f "$temporary" "$HISTORY_FILE"
}

restore_previous_wallpaper() {
    local current
    local previous
    local id
    local output
    local temporary

    current=$(jq -r '.current // -1' "$HISTORY_FILE")
    if [[ ! "$current" =~ ^[0-9]+$ ]] || (( current < 1 )); then
        notify_error "No Previous Wallpaper" "Wallpaper history has no earlier entry"
        return 1
    fi

    previous=$((current - 1))
    id=$(jq -r --argjson index "$previous" '.entries[$index].id // empty' "$HISTORY_FILE")
    if [[ ! "$id" =~ ^[[:alnum:]]+$ ]]; then
        notify_error "Could Not Restore Wallpaper" "The history entry is invalid"
        return 1
    fi

    notify_start "Restoring Wallpaper..." "Wallhaven: $id"
    output=$(wallchemy --id "$id" 2>&1) || {
        notify_error "Could Not Restore Wallpaper" "$output"
        return 1
    }

    temporary=$(mktemp "$STATE_DIR/.history.XXXXXX")
    if ! jq --argjson index "$previous" '.current = $index' "$HISTORY_FILE" > "$temporary"; then
        rm -f "$temporary"
        notify_error "Could Not Restore Wallpaper" "Failed to update wallpaper history"
        return 1
    fi
    mv -f "$temporary" "$HISTORY_FILE"

    prune_wallchemy_cache
    notify_success "Wallpaper Restored" "Wallhaven: $id" "preferences-desktop-wallpaper"
}

# -----------------------------------------------------------------
# Helper: Run wallchemy, parse output image path, notify outcome
# -----------------------------------------------------------------

run_wallchemy() {
    local label="$1"
    shift
    local output=""
    local exit_code=0

    # Record the currently displayed wallpaper before replacing it, so the
    # first rotation after enabling history can be undone as well.
    record_current_wallpaper "Previous wallpaper"
    output=$(wallchemy "$@" 2>&1) || exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        record_current_wallpaper "$label"
        prune_wallchemy_cache
        notify_success "Wallpaper Updated" "$label" "preferences-desktop-wallpaper"
    else
        local err_summary
        err_summary=$(echo "$output" | tail -n 2 | tr '\n' ' ')
        notify_error "Wallpaper Fetch Failed" "${err_summary:-Unknown error (code $exit_code)}"
        return $exit_code
    fi
}

# -----------------------------------------------------------------
# Favorites
# -----------------------------------------------------------------

current_wallpaper_info() {
    local info

    info=$(wallchemy --info 2>&1) || {
        notify_error "Could Not Read Wallpaper" "$info"
        return 1
    }

    CURRENT_ID=$(printf '%s\n' "$info" | sed -n '1p')
    CURRENT_IMAGE_URL=$(printf '%s\n' "$info" | sed -n '2p')
    CURRENT_PAGE_URL=$(printf '%s\n' "$info" | sed -n '3p')
    CURRENT_IMAGE_PATH=$(printf '%s\n' "$info" | sed -n '4p')

    if [[ ! "$CURRENT_ID" =~ ^[[:alnum:]]+$ ]] \
        || [[ ! "$CURRENT_PAGE_URL" =~ ^https://wallhaven\.cc/w/[[:alnum:]]+$ ]] \
        || [[ ! -f "$CURRENT_IMAGE_PATH" ]]; then
        notify_error "Could Not Read Wallpaper" "Wallchemy returned incomplete current-wallpaper information"
        return 1
    fi
}

favorite_metadata_path() {
    printf '%s/wallhaven-%s.json\n' "$FAVORITES_METADATA_DIR" "$1"
}

favorite_image_path() {
    local metadata
    local image_file

    metadata=$(favorite_metadata_path "$1")
    [[ -f "$metadata" ]] || return 1

    image_file=$(jq -r '.image_file // empty' "$metadata")
    [[ "$image_file" != */* && -n "$image_file" ]] || return 1

    printf '%s/%s\n' "$FAVORITES_DIR" "$image_file"
}

save_favorite() {
    local metadata
    local extension
    local image_file
    local destination
    local temporary
    local active_wallpaper
    local active_wallpaper_real
    local wallchemy_wallpaper_real

    current_wallpaper_info || return 1

    # Wallchemy's --info reports its last download. Confirm it is still the
    # wallpaper Noctalia is displaying, rather than archiving a stale image.
    active_wallpaper=$(noctalia msg wallpaper-get 2>/dev/null || true)
    if [[ -n "$active_wallpaper" && -e "$active_wallpaper" ]]; then
        active_wallpaper_real=$(readlink -f "$active_wallpaper")
        wallchemy_wallpaper_real=$(readlink -f "$CURRENT_IMAGE_PATH")
        if [[ "$active_wallpaper_real" != "$wallchemy_wallpaper_real" ]]; then
            if [[ "$active_wallpaper_real" == "$FAVORITES_DIR/"* ]]; then
                notify_success "Wallpaper Already Saved" "The active wallpaper is already a favorite" "emblem-favorite"
            else
                notify_error "Could Not Save Favorite" "The active wallpaper was not set by Wallchemy"
            fi
            return 0
        fi
    fi

    metadata=$(favorite_metadata_path "$CURRENT_ID")

    if [[ -f "$metadata" ]]; then
        notify_success "Wallpaper Already Saved" "Wallhaven: $CURRENT_ID" "emblem-favorite"
        return 0
    fi

    extension="${CURRENT_IMAGE_PATH##*.}"
    if [[ ! "$extension" =~ ^[[:alnum:]]+$ ]]; then
        notify_error "Could Not Save Favorite" "Current wallpaper has an unsupported file extension"
        return 1
    fi

    image_file="wallhaven-${CURRENT_ID}.${extension,,}"
    destination="$FAVORITES_DIR/$image_file"
    temporary=$(mktemp "$FAVORITES_DIR/.wallhaven-${CURRENT_ID}.XXXXXX")

    notify_start "Saving Favorite..." "Wallhaven: $CURRENT_ID"
    if ! cp --reflink=auto --preserve=mode,timestamps "$CURRENT_IMAGE_PATH" "$temporary"; then
        rm -f "$temporary"
        notify_error "Could Not Save Favorite" "Failed to archive the wallpaper image"
        return 1
    fi
    mv -f "$temporary" "$destination"

    if ! jq -n \
        --arg id "$CURRENT_ID" \
        --arg image_url "$CURRENT_IMAGE_URL" \
        --arg page_url "$CURRENT_PAGE_URL" \
        --arg image_file "$image_file" \
        --arg saved_at "$(date --iso-8601=seconds)" \
        '{id: $id, image_url: $image_url, page_url: $page_url, image_file: $image_file, saved_at: $saved_at}' \
        > "$metadata"; then
        rm -f "$destination" "$metadata"
        notify_error "Could Not Save Favorite" "Failed to write favorite metadata"
        return 1
    fi

    notify_success "Wallpaper Saved" "Wallhaven: $CURRENT_ID" "emblem-favorite"
}

favorite_entries() {
    local metadata
    local id
    local saved_at

    shopt -s nullglob
    for metadata in "$FAVORITES_METADATA_DIR"/wallhaven-*.json; do
        id=$(jq -r '.id // empty' "$metadata")
        saved_at=$(jq -r '.saved_at // "unknown date"' "$metadata")
        [[ "$id" =~ ^[[:alnum:]]+$ ]] || continue
        printf '%s\tWallhaven %s — saved %s\n' "$id" "$id" "$saved_at"
    done
}

open_favorites_gallery() {
    thunar "$FAVORITES_DIR" >/dev/null 2>&1 &
    notify_success "Favorite Wallpapers" "Opened gallery in Thunar" "folder-pictures"
}

manage_favorite() {
    local id="$1"
    local metadata
    local image
    local page_url
    local action

    metadata=$(favorite_metadata_path "$id")
    image=$(favorite_image_path "$id") || {
        notify_error "Favorite Not Found" "Wallhaven: $id"
        return 1
    }

    action=$(printf '%s\n' "Set wallpaper" "Open Wallhaven page" "Remove from favorites" | noctalia dmenu -p "Favorite $id")
    [[ -n "$action" ]] || return 0

    case "$action" in
        "Set wallpaper")
            if [[ ! -f "$image" ]]; then
                notify_error "Favorite Not Found" "Archived image is missing for Wallhaven: $id"
                return 1
            fi
            notify_start "Setting Favorite..." "Wallhaven: $id"
            noctalia msg wallpaper-set "$image" >/dev/null || {
                notify_error "Could Not Set Favorite" "Wallhaven: $id"
                return 1
            }
            notify_success "Wallpaper Updated" "Favorite: $id" "preferences-desktop-wallpaper"
            ;;
        "Open Wallhaven page")
            page_url=$(jq -r '.page_url // empty' "$metadata")
            if [[ ! "$page_url" =~ ^https://wallhaven\.cc/w/[[:alnum:]]+$ ]]; then
                notify_error "Could Not Open Wallpaper" "Favorite has no valid Wallhaven link"
                return 1
            fi
            xdg-open "$page_url" >/dev/null 2>&1 || {
                notify_error "Could Not Open Wallpaper" "xdg-open failed to launch the browser"
                return 1
            }
            notify_success "Wallhaven Opened" "$page_url" "internet-web-browser"
            ;;
        "Remove from favorites")
            rm -f "$image" "$metadata"
            notify_success "Favorite Removed" "Wallhaven: $id" "user-trash"
            ;;
    esac
}

browse_favorites() {
    local selection
    local id

    selection=$( {
        printf '%s\n' "Open gallery in Thunar"
        favorite_entries
    } | noctalia dmenu -p "Favorite wallpapers")
    [[ -n "$selection" ]] || return 0

    if [[ "$selection" == "Open gallery in Thunar" ]]; then
        open_favorites_gallery
        return 0
    fi

    id=${selection%%$'\t'*}
    [[ "$id" =~ ^[[:alnum:]]+$ ]] || return 0
    manage_favorite "$id"
}

# -----------------------------------------------------------------
# Actions
# -----------------------------------------------------------------

case "$ACTION" in
    next|rotate)
        MODES=("random" "top" "hot")
        if [[ ${#COLLECTIONS[@]} -gt 0 ]]; then
            MODES+=("collection")
        fi

        if [[ -f "$STATE_FILE" ]]; then
            INDEX=$(cat "$STATE_FILE")
        else
            INDEX=0
        fi

        MODE="${MODES[$((INDEX % ${#MODES[@]}))]}"
        echo $(( (INDEX + 1) % ${#MODES[@]} )) > "$STATE_FILE"

        case "$MODE" in
            random)
                TERM="${SEARCH_TERMS[$RANDOM % ${#SEARCH_TERMS[@]}]}"
                notify_start "Fetching Wallpaper..." "Mode: Random ('$TERM')"
                run_wallchemy "Random: $TERM" --random "$TERM"
                ;;
            top)
                notify_start "Fetching Wallpaper..." "Mode: Top ($TOP_RANGE)"
                run_wallchemy "Top ($TOP_RANGE)" --top --range "$TOP_RANGE"
                ;;
            hot)
                notify_start "Fetching Wallpaper..." "Mode: Hot"
                run_wallchemy "Hot" --hot
                ;;
            collection)
                COLL="${COLLECTIONS[$RANDOM % ${#COLLECTIONS[@]}]}"
                notify_start "Fetching Wallpaper..." "Collection: '$COLL'"
                run_wallchemy "Collection: $COLL" --collection "$COLL"
                ;;
        esac
        ;;

    random)
        TERM="${SUB_ARG:-${SEARCH_TERMS[$RANDOM % ${#SEARCH_TERMS[@]}]}}"
        notify_start "Fetching Wallpaper..." "Random search: '$TERM'"
        run_wallchemy "Random: $TERM" --random "$TERM"
        ;;

    top)
        RANGE="${SUB_ARG:-$TOP_RANGE}"
        notify_start "Fetching Wallpaper..." "Top wallpapers ($RANGE)"
        run_wallchemy "Top ($RANGE)" --top --range "$RANGE"
        ;;

    hot)
        notify_start "Fetching Wallpaper..." "Mode: Hot"
        run_wallchemy "Hot" --hot
        ;;

    collection)
        if [[ -n "$SUB_ARG" ]]; then
            COLL="$SUB_ARG"
        elif [[ ${#COLLECTIONS[@]} -gt 0 ]]; then
            COLL="${COLLECTIONS[$RANDOM % ${#COLLECTIONS[@]}]}"
        else
            notify_error "Wallchemy" "No collections configured in wallchemy-rotate"
            exit 1
        fi
        notify_start "Fetching Wallpaper..." "Collection: '$COLL'"
        run_wallchemy "Collection: $COLL" --collection "$COLL"
        ;;

    favorite|favourite)
        save_favorite
        ;;

    favorites|favourites)
        case "$SUB_ARG" in
            "")
                browse_favorites
                ;;
            gallery)
                open_favorites_gallery
                ;;
            *)
                echo "Usage: $0 [--silent] favorites [gallery]" >&2
                exit 1
                ;;
        esac
        ;;

    prune-cache)
        prune_wallchemy_cache
        notify_success "Wallchemy Cache Pruned" "Keeping $CACHE_KEEP newest wallpapers" "edit-clear"
        ;;

    previous|prev)
        restore_previous_wallpaper
        ;;

    open)
        notify_start "Wallchemy" "Opening the current wallpaper on Wallhaven..."
        info=$(wallchemy --info 2>&1) || {
            notify_error "Could Not Open Wallpaper" "$info"
            exit 1
        }
        url=$(printf '%s\n' "$info" | sed -n '3p')
        if [[ ! "$url" =~ ^https://wallhaven\.cc/w/[[:alnum:]]+$ ]]; then
            notify_error "Could Not Open Wallpaper" "Current wallpaper has no valid Wallhaven link"
            exit 1
        fi
        xdg-open "$url" >/dev/null 2>&1 || {
            notify_error "Could Not Open Wallpaper" "xdg-open failed to launch the browser"
            exit 1
        }
        notify_success "Wallhaven Opened" "$url" "internet-web-browser"
        ;;

    blacklist)
        notify_start "Wallchemy" "Blacklisting current wallpaper..."
        out=$(wallchemy --blacklist current 2>&1) || {
            notify_error "Blacklist Failed" "$out"
            exit 1
        }
        notify_success "Wallpaper Blacklisted" "$out"
        # Immediately fetch next wallpaper.
        if [[ "$SILENT" == true ]]; then
            "$0" --silent next
        else
            "$0" next
        fi
        ;;

    *)
        echo "Usage: $0 [--silent] [next|random|top|hot|collection|favorite|favorites|prune-cache|previous|open|blacklist]" >&2
        exit 1
        ;;
esac
