#!/usr/bin/env python3
"""Searchable Niri shortcut reference using Noctalia's dmenu."""

from __future__ import annotations

import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "niri"
TITLE_RE = re.compile(r'hotkey-overlay-title="([^"]+)"')
KEY_RE = re.compile(r"^\s*([^\s={}]+)\s+.*hotkey-overlay-title=")
INCLUDE_RE = re.compile(r'^\s*include(?:\s+optional=true)?\s+"([^"]+)"')


def strip_comments(line: str) -> str:
    return re.sub(r"//.*$", "", line)


def parse_config(path: Path, binds: dict[str, tuple[str, str]], seen: set[Path]) -> None:
    """Collect titled bindings and their Niri actions; later binds replace earlier ones."""
    try:
        path = path.resolve()
        if path in seen:
            return
        seen.add(path)
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return

    buffer = ""
    for line in lines:
        clean = strip_comments(line).strip()
        if not clean:
            continue

        include = INCLUDE_RE.match(clean)
        if include:
            included = Path(include.group(1)).expanduser()
            if not included.is_absolute():
                included = path.parent / included
            parse_config(included, binds, seen)
            buffer = ""
            continue

        buffer = f"{buffer} {clean}".strip()
        title = TITLE_RE.search(buffer)
        if title and "{" in buffer and "}" in buffer:
            key = KEY_RE.search(buffer)
            action = re.search(r"\{\s*(.*?)\s*\}", buffer)
            if key and action and key.group(1) != "binds":
                # `niri msg action` accepts the action body, not KDL's braces.
                raw_action = action.group(1).rstrip(";").strip()
                if raw_action.startswith("spawn "):
                    # The CLI's spawn action needs `--` before its command.
                    raw_action = "spawn -- " + raw_action[len("spawn "):]
                binds[key.group(1)] = (title.group(1), raw_action)
            buffer = ""
        elif "}" in clean and not TITLE_RE.search(buffer):
            buffer = ""


def main() -> int:
    binds: dict[str, str] = {}
    parse_config(CONFIG_DIR / "config.kdl", binds, set())

    if not binds:
        print("No titled Niri shortcuts found.", file=sys.stderr)
        return 1

    # Put both key and description in every entry: Noctalia dmenu filters either.
    entries = {f"{key:<28} {title}": action for key, (title, action) in binds.items()}
    menu = "\n".join(sorted(entries, key=str.casefold)) + "\n"
    selection = subprocess.run(
        ["noctalia", "dmenu", "--prompt", "Search keyboard shortcuts"],
        input=menu,
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    ).stdout.rstrip("\n")

    if not selection:
        return 0  # The menu was dismissed.

    action = entries.get(selection)
    if action is None:
        print("Selected shortcut is no longer available.", file=sys.stderr)
        return 1

    # Parse arguments without a shell: actions originate only from the local
    # Niri configuration, and quotes in spawn/spawn-sh arguments are preserved.
    return subprocess.run(["niri", "msg", "action", *shlex.split(action)], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
