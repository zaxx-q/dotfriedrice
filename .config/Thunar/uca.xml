	<icon>audio-card</icon>
	<name>Extract Audio to Opus (.ogg)</name>
	<submenu>Video</submenu>
	<unique-id>1790054734239877-4</unique-id>
	<command>bash -c &apos;notify-send &quot;Audio Extraction&quot; &quot;Started converting $# file(s)...&quot; -i multimedia-audio-player; for f in &quot;$@&quot;; do ffmpeg -y -i &quot;$f&quot; -vn -c:a libopus -b:a 128k &quot;${f%%.*}.ogg&quot;; done; notify-send &quot;Audio Extraction&quot; &quot;Finished converting $# file(s)!&quot; -i dialog-information&apos; _ %F</command>
	<description>Converts video audio to Opus format inside an Ogg container</description>
	<range>*</range>
	<patterns>*</patterns>
	<video-files/>
</action>
