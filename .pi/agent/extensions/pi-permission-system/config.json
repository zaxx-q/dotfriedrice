{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "doublePressToConfirm": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "allow",
      "sudo *": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "md5sum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "cksum *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "ps *": "allow",
      "printenv *": "allow",
      "which *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "jq *": "allow",
      "git *": "allow",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git branch -D *": "allow",
      "git branch -d *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "npm *": "allow",
      "npm publish *": "ask",
      "npx *": "allow",
      "pnpm *": "allow",
      "pnpm publish *": "ask",
      "bun *": "allow",
      "bunx *": "allow",
      "node *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "poetry *": "allow",
      "uv *": "allow",
      "cargo *": "allow",
      "cargo publish *": "ask",
      "go *": "allow",
      "deno *": "allow",
      "make *": "allow",
      "cmake *": "allow",
      "gcc *": "allow",
      "g++ *": "allow",
      "clang *": "allow",
      "docker *": "allow",
      "docker compose *": "allow",
      "docker-compose *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.cache/.bun/install/global/node_modules/@earendil-works/pi-coding-agent/*": "allow"
    }
  }
}
